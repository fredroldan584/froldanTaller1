<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="froldanTaller1.MainPage"
             Title="Taller Semana 1">

    <ScrollView>
        <VerticalStackLayout x:Name="contenedor" Padding="20" Spacing="10" HorizontalOptions="Center">

            <Label Text="Taller Semana 1" TextColor="Red" FontSize="24" HorizontalOptions="Center" />
            <Label Text="Formulario de inscripción:" TextColor="DodgerBlue" FontSize="20" Margin="0,10,0,0" />
            <Image Source="uisrael.png" HeightRequest="110" HorizontalOptions="Center" />

            <Label Text="Datos Personales" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0" />

            <Label Text="Identificación:" />
            <Picker x:Name="pkTipoId" Title="Seleccione: Cédula / RUC / Pasaporte"
                    SelectedIndexChanged="pkTipoId_SelectedIndexChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>CÉDULA</x:String>
                        <x:String>RUC</x:String>
                        <x:String>PASAPORTE</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            <Entry x:Name="txtIdentificacion" Placeholder="Identificación: Cédula/RUC/Pasaporte"
                   TextChanged="txtIdentificacion_TextChanged" />

            <Label Text="Apellidos:" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Entry x:Name="txtApellidoPaterno" Placeholder="Apellido paterno"
                       TextChanged="SoloLetras_TextChanged" />
                <Entry x:Name="txtApellidoMaterno" Grid.Column="1" Placeholder="Apellido materno"
                       TextChanged="SoloLetras_TextChanged" />
            </Grid>

            <Label Text="Nombres completos:" />
            <Entry x:Name="txtNombres" Placeholder="Nombres completos"
                   TextChanged="SoloLetras_TextChanged" />

            <Label Text="Género:" />
            <Picker x:Name="pkGenero" Title="Seleccione">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>MUJER</x:String>
                        <x:String>HOMBRE</x:String>
                        <x:String>OTRO</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Text="Fecha nacimiento:" />
            <DatePicker x:Name="dpFechaNacimiento" Format="dd/MM/yyyy" />

            <Label Text="Estado civil:" />
            <Picker x:Name="pkEstadoCivil" Title="Seleccione">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>SOLTERO</x:String>
                        <x:String>CASADO</x:String>
                        <x:String>DIVORCIADO</x:String>
                        <x:String>VIUDO</x:String>
                        <x:String>UNIÓN LIBRE</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Text="Teléfono personal:" />
            <Entry x:Name="txtTelefono" Placeholder="09XXXXXXXX" Keyboard="Telephone"
                   MaxLength="10" TextChanged="SoloNumeros_TextChanged" />

            <Label Text="Correo personal:" />
            <Entry x:Name="txtCorreo" Placeholder="correo@ejemplo.com" Keyboard="Email" />

            <Label Text="Confirmar correo:" />
            <Entry x:Name="txtConfirmarCorreo" Placeholder="Repita su correo" Keyboard="Email" />

            <Label Text="Carrera:" />
            <Picker x:Name="pkCarrera" Title="Seleccione la carrera">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>ADMINISTRACIÓN DE EMPRESAS</x:String>
                        <x:String>CONTABILIDAD Y AUDITORÍA</x:String>
                        <x:String>DISEÑO DIGITAL</x:String>
                        <x:String>EDUCACIÓN BÁSICA</x:String>
                        <x:String>EDUCACIÓN INICIAL</x:String>
                        <x:String>ELECTRÓNICA Y AUTOMATIZACIÓN</x:String>
                        <x:String>INFORMÁTICA</x:String>
                        <x:String>MEDICINA</x:String>
                        <x:String>PSICOLOGÍA</x:String>
                        <x:String>SISTEMAS DE INFORMACIÓN</x:String>
                        <x:String>TELECOMUNICACIONES</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Text="Modalidad:" />
            <Picker x:Name="pkModalidad" Title="Seleccione la modalidad">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>PRESENCIAL</x:String>
                        <x:String>SEMIPRESENCIAL</x:String>
                        <x:String>EN LÍNEA</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Text="Campus:" />
            <Picker x:Name="pkCampus" Title="Seleccione el campus">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>MATRIZ - QUITO</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Button x:Name="btnGuardar" Text="GUARDAR DATOS" Margin="0,15,0,0"
                    BackgroundColor="#512BD4" TextColor="White"
                    Clicked="btnGuardar_Clicked" />
            <Button x:Name="btnVerArchivo" Text="VER ARCHIVO TXT"
                    BackgroundColor="Gray" TextColor="White"
                    Clicked="btnVerArchivo_Clicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
